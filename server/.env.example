# PostgreSQL connection string.
# IMPORTANT: point this at YOUR OWN PostgreSQL server/database.
# NEVER point it at shared or production databases (e.g. the read-only Supabase instance).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frutales?schema=public"

# Port the Express API listens on.
PORT=4000

# Allowed CORS origin (the Vite dev server by default).
CLIENT_ORIGIN="http://localhost:5173"

# Opcional: URL propia para la tasa USD -> COP (TRM).
# Si se omite, se usa la TRM oficial (datos.gov.co) y open.er-api.com como respaldo.
# EXCHANGE_RATE_API_URL="https://www.datos.gov.co/resource/32sa-8pi3.json?$limit=1&$order=vigenciadesde%20DESC"

# Secreto para firmar las sesiones JWT (mínimo 32 caracteres, OBLIGATORIO).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia_este_secreto_por_uno_largo_y_aleatorio"
JWT_EXPIRES_IN=7d

# Administrador inicial para `npm run db:seed` (opcional).
# Si ya existe un usuario con ese correo, el seed no lo modifica.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="cambia_esta_contrasena"
