# PostgreSQL connection string.
# IMPORTANT: point this at YOUR OWN PostgreSQL server/database.
# NEVER point it at shared or production databases (e.g. the read-only Supabase instance).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frutales?schema=public"

# Port the Express API listens on.
PORT=4000

# Allowed CORS origin (the Vite dev server by default).
CLIENT_ORIGIN="http://localhost:5173"
