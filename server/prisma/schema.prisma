// Prisma schema for the Frutales project tracker (PostgreSQL).
//
// Run `npx prisma migrate dev --name <name>` to create new migrations in
// development, and `npm run prisma:deploy` (or the compose "migrate" service)
// in production. Do NOT run migrations against shared/read-only databases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rol de acceso al sistema. "admin" gestiona usuarios; "usuario" usa la app.
enum UserRole {
  admin
  usuario
}

/// Usuario que puede iniciar sesión en la aplicación.
/// La contraseña se guarda SIEMPRE como hash bcrypt, nunca en texto plano.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(usuario)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// A processing batch: raw product bought, transformed, and (optionally) sold.
///
/// Phase 1 (compra y procesamiento) is captured by the non-null columns below.
/// Phase 2 (venta) is fully optional: every sale column is nullable so a
/// project can be saved as soon as Phase 1 is done.
///
/// Derived money values (totalCost, totalRevenue, netProfit) are intentionally
/// NOT stored: they are computed from these columns at read time so they can
/// never go stale (see src/modules/projects/projects.mapper.ts).
model Project {
  id                 String   @id @default(cuid())
  name               String // e.g. "Lote 1 de piña"
  productName        String // e.g. "Piña"
  processType        String // e.g. "Deshidratada", "Melada"
  initialQty         Decimal  @db.Decimal(12, 3) // kg purchased
  purchasePrice      Decimal  @db.Decimal(12, 2) // price per kg purchased (in `purchaseCurrency`)
  purchaseCurrency    String?  // "COP" | "USD" — currency of the purchase price; null on legacy rows (treated as COP)
  purchaseExchangeRate Decimal? @db.Decimal(12, 4) // COP per USD captured when the purchase was made in USD
  purchaseImage       String?  // data URL of the purchase receipt (comprobante de compra)
  reductionPct       Decimal  @db.Decimal(5, 2) // % of weight lost during processing
  netYield           Decimal  @db.Decimal(12, 3) // kg after processing (auto-calculated or manually overridden)
  netYieldOverridden Boolean  @default(false) // true when the user typed a custom net yield

  // ---------------------------------------------------------------------------
  // Fase 2: venta (all optional — null until the sale is registered)
  // ---------------------------------------------------------------------------
  sellingPrice         Decimal?  @db.Decimal(12, 2) // price per kg of net yield (in `currency`)
  currency             String? // "COP" | "USD" — sale currency; null on legacy rows (treated as COP)
  exchangeRate         Decimal?  @db.Decimal(12, 4) // COP per USD captured when the USD sale was registered
  saleImage            String? // data URL of the sale receipt (comprobante de venta)
  buyerName            String?
  buyerContact         String?
  transactionDate      DateTime?
  paymentType          String? // "Contado" | "Crédito"
  scheduledPaymentDate DateTime? // required when paymentType = "Crédito"
  /// "Pendiente" | "Pagado" | "Vencido". Cached at write time for querying;
  /// the API recomputes it dynamically on every read (a credit sale becomes
  /// "Vencido" over time without any database write).
  paymentStatus String?

  // ---------------------------------------------------------------------------
  // Catálogo maestro: optional FKs, linked later (the free-text fields below
  // stay authoritative for now to keep existing data intact).
  // ---------------------------------------------------------------------------
  productId String?
  processId String?
  clientId  String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  process   Process? @relation(fields: [processId], references: [id], onDelete: SetNull)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  payments Payment[]

  @@index([createdAt])
  @@index([paymentStatus])
  @@map("projects")
}

/// Abono o pago parcial registrado contra la venta de un proyecto.
/// La suma de pagos (normalizada a COP) define el estado del pago.
model Payment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(12, 2)
  currency     String? // "COP" | "USD" — currency of the amount; null on legacy rows (treated as COP)
  exchangeRate Decimal? @db.Decimal(12, 4) // COP per USD captured when the payment was registered in USD
  note         String? // nota u observación opcional ("abono quincenal", ...)
  image        String? // data URL of the payment receipt (comprobante)
  date         DateTime? // fecha del pago
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@map("payments")
}

/// Gasto adicional de un proyecto (empaque, transporte, mano de obra, etc.).
/// Se suma al costo total y por lo tanto reduce la ganancia neta.
model Expense {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept      String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String? // "COP" | "USD" — currency of the amount; null on legacy rows (treated as COP)
  exchangeRate Decimal? @db.Decimal(12, 4) // COP per USD captured when the expense was registered in USD
  image        String? // data URL of the expense receipt (comprobante)
  date         DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@map("expenses")
}

/// Catálogo de productos (frutas o productos procesados).
model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@map("products")
}

/// Catálogo de tipos de proceso (p. ej. "Melada", "Deshidratada").
model Process {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("processes")
}

/// Catálogo de clientes (compradores registrados en las ventas).
model Client {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("clients")
}
