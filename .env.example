# ---------------------------------------------------------------------------
# Frutales — Docker Compose environment.
# Copy this file to ".env" and change the password before deploying.
# ---------------------------------------------------------------------------

# PostgreSQL credentials used by the "db" container.
POSTGRES_USER=frutales
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=frutales

# Connection string used by the API container.
# IMPORTANT: the host must be the compose service name "db" and the
# user/password/database must match the POSTGRES_* values above
# (compose does not expand nested variables inside .env).
DATABASE_URL=postgresql://frutales:change_me_please@db:5432/frutales?schema=public

# Runtime environment for the API container.
NODE_ENV=production

# Allowed CORS origin. In production the browser calls the API through the
# nginx proxy on the same origin, so this only matters for cross-origin calls.
CLIENT_ORIGIN=http://localhost
